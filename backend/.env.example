SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# JWT (Phase 3) — min 32 caractères
JWT_SECRET=CHANGE_ME_DEV_ONLY_32CHARS_MINIMUM_OK
JWT_ISSUER=agroshield
JWT_AUDIENCE=agroshield-api

# AI Service local (jury)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_TOKEN=agroshield-jury-token
AI_CONNECT_TIMEOUT=2s
AI_READ_TIMEOUT=30s

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres / Redis (Phase 2+ — docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5433/agroshield
DATABASE_USERNAME=agroshield
DATABASE_PASSWORD=agroshield
REDIS_URL=redis://localhost:6379
